# Copy this file to ".env" (same folder) and fill it in.
# Never commit .env to GitHub: it contains passwords.

# Web server
PORT=3000

# MySQL connection used by the website (a limited account: read/write data only)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pour
DB_USER=pour_app
DB_PASSWORD=pick-a-long-password-here
DB_POOL_SIZE=10
# Set to true if your hosted MySQL requires SSL
DB_SSL=false

# Only used by "npm run db:setup" to create the database and the user above
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=your-mysql-root-password
# Host the app user may connect from: localhost, or % for a hosted database
DB_APP_HOST=localhost

# true = create the tables and load the 21 recipes on first start if the
# database is empty (used on Railway instead of "npm run db:setup")
DB_AUTO_SETUP=false

# On Railway you don't need the DB_ lines above: the server also reads
# MYSQL_URL (or MYSQLHOST, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE).

# How long API results are cached in memory (seconds)
CACHE_TTL_SECONDS=300

# true  = visitors' recipes appear immediately
# false = they wait until you publish them (see DATABASE.md, "Moderating")
AUTO_PUBLISH=true

# Usernames of site admins (comma separated). Admins can edit/delete ANY
# community recipe and reset other users' passwords. Create the account on
# the site first (account.html), then put its username here.
ADMIN_USERNAMES=

# Optional secret for using the admin API from a terminal (curl). Leave empty to turn it off.
ADMIN_TOKEN=

# Where uploaded photos are saved (relative to the website folder)
UPLOAD_DIR=uploads
MAX_SUBMISSIONS_PER_HOUR=5

# If the HTML is hosted somewhere else (e.g. GitHub Pages) and calls this
# server's API, list that site here (comma separated, no trailing slash)
ALLOWED_ORIGINS=
# true when running behind a proxy/load balancer (Render, Railway, nginx...)
TRUST_PROXY=false
